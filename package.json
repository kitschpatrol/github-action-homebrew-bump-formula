{
	"name": "github-action-homebrew-bump-formula",
	"version": "9.0.0",
	"private": true,
	"description": "A GitHub Action to easily bump a Homebrew formula on new release.",
	"keywords": [
		"github-action",
		"action",
		"formula",
		"homebrew"
	],
	"homepage": "https://github.com/kitschpatrol/github-action-homebrew-bump-formula",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/github-action-homebrew-bump-formula.git"
	},
	"license": "MIT",
	"author": {
		"name": "Dawid Dziurla"
	},
	"contributors": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc-prettier fix",
		"lint": "ksc-prettier lint",
		"release": "bumpp --commit 'Release: %s' && ./scripts/sync-major-tag.sh"
	},
	"devDependencies": {
		"@kitschpatrol/prettier-config": "^8.13.1",
		"bumpp": "^12.3.0",
		"shx": "^0.4.0"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.0.0"
	}
}
